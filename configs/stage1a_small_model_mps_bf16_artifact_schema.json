{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1a-small-model-mps-bf16-artifact-bundle-v1",
  "title": "Stage 1A-S-BF16 small derived artifact bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
